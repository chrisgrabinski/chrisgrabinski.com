{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["node_modules", ".next", "dist", "build", "**/*.svg"],
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "nextjs", "jsx-a11y"],
  "rules": {
    "jsx-a11y/prefer-tag-over-role": "off"
  }
}
